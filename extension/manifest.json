{
  "manifest_version": 3,
  "name": "稿台多平台分发",
  "version": "1.0.0",
  "description": "连接稿台桌面版，一键推送文章到知乎/掘金/CSDN/小红书/飞书/微博/头条/B站/百家号/思否/开源中国/博客园/抖音/豆瓣/雪球/人人都是产品经理/大鱼号/X。",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "platform-adapters/types.js",
        "platform-adapters/zhihu.js",
        "platform-adapters/juejin.js",
        "platform-adapters/csdn.js",
        "platform-adapters/xiaohongshu.js",
        "platform-adapters/feishu.js",
        "platform-adapters/weibo.js",
        "platform-adapters/toutiao.js",
        "platform-adapters/bilibili.js",
        "platform-adapters/baijiahao.js",
        "platform-adapters/segmentfault.js",
        "platform-adapters/oschina.js",
        "platform-adapters/cnblogs.js",
        "platform-adapters/douyin.js",
        "platform-adapters/douban.js",
        "platform-adapters/xueqiu.js",
        "platform-adapters/woshipm.js",
        "platform-adapters/dayu.js",
        "platform-adapters/x.js",
        "platform-adapters/index.js",
        "wechatsync-bridge.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
