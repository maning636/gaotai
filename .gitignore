# 依赖与构建产物
node_modules/
.next/
out/
dist/
release/
release-new/
*.tsbuildinfo

# 本地数据目录：数据库、本地专题、登录日志、配图
/data/
/images/
/.tmp/

# 授权缓存与激活后下发的资产。开发态 dataDir 回落到项目根时会落在这里；
# 桌面版则在用户数据目录，不在仓库里。
/.license/
/assets/

# 密钥文件。桌面版在用户数据目录生成，这里只忽略本地开发用的。
.env
.env.*
!.env.example

# 截图产物：PNG 是二进制，每次重跑都产生巨大 diff，仓库会被撑爆。
# 要留档就传到网盘或对象存储（见 docs/截图规范.md 第三节）。
/shots/

.DS_Store
Thumbs.db
