{
  "name": "gaotai",
  "version": "0.6.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "稿台 —— 面向公众号创作者的本地写作工作台（桌面版）",
  "author": "maning636",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3060",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3060",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/tests/run-all.ts",
    "deps-gate": "tsx scripts/check-deps-coverage.mts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run deps-gate",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "desktop": "electron .",
    "desktop:dev": "node scripts/run-desktop.mjs dev",
    "desktop:build": "npm run build && node scripts/ensure-runtime-deps.mjs && node scripts/copy-standalone-assets.mjs && node scripts/sanitize-standalone.mjs && node scripts/prepare-resources.mjs && electron-builder --win && node scripts/verify-package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "canvas": "^3.2.3",
    "highlight.js": "^11.12.0",
    "jsdom": "^31.0.0",
    "juice": "^12.2.1",
    "mathjax-full": "^3.2.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "mermaid": "^12.3.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "modern-screenshot": "^4.7.0",
    "next": "^16.3.5",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.7",
    "postcss-value-parser": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
