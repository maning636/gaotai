{
  "name": "深度阅读",
  "description": "源自 rico-md 的「深度阅读」主题（MIT, ricocc/rico-md）。",
  "source": "imported",
  "vars": {
    "text": "#0c0c0c",
    "heading": "#0a0a0a",
    "muted": "#1a1a1a",
    "codeText": "#007aaa",
    "surface": "#f6f8fa",
    "accent": "#0066cc"
  },
  "parts": {
    "root": {
      "html": "<section style=\"max-width: 100%; margin: 0 auto; padding: 14px 12px 32px 12px; font-family: -apple-system, BlinkMacSystemFont, SF Pro Text, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif; font-size: 16px; line-height: 1.75; color: {{muted}}; letter-spacing: -0.2px; background-color: #fff; word-wrap: break-word; letter-spacing: 0.01em\">{{content}}</section>"
    },
    "title": {
      "html": "<{{tag}} style=\"font-size: 32px; font-weight: 700; color: {{heading}}; line-height: 1.2; margin: 48px 0 24px; letter-spacing: -0.02em\">{{content}}</{{tag}}>"
    },
    "heading": {
      "html": "<{{tag}} style=\"font-size: 28px; font-weight: 700; color: {{heading}}; line-height: 1.3; margin: 40px 0 20px; letter-spacing: -0.01em\">{{content}}</{{tag}}>"
    },
    "heading3": {
      "html": "<{{tag}} style=\"font-size: 22px; font-weight: 700; color: {{heading}}; line-height: 1.4; margin: 32px 0 24px\">{{content}}</{{tag}}>"
    },
    "heading4": {
      "html": "<{{tag}} style=\"font-size: 20px; font-weight: 700; color: {{heading}}; line-height: 1.5; margin: 28px 0 14px\">{{content}}</{{tag}}>"
    },
    "paragraph": {
      "html": "<p style=\"margin: 24px 0; line-height: 2; color: {{text}}\">{{content}}</p>"
    },
    "strong": {
      "html": "<strong style=\"font-weight: 600; color: {{heading}}; border-bottom: 1px dashed #53b6ff\">{{content}}</strong>"
    },
    "em": {
      "html": "<em style=\"font-style: italic; color: #2a2a2a\">{{content}}</em>"
    },
    "inlineCode": {
      "html": "<code style=\"font-family: SF Mono, Consolas, Monaco, Courier New, monospace; font-size: 14px; padding: 2px 6px; background: #f2f2f1; color: {{codeText}}; border-radius: 3px\">{{content}}</code>"
    },
    "code": {
      "html": "<pre style=\"margin: 32px 0; padding: 24px; background: #f2f2f1; border-radius: 8px; overflow-x: auto; line-height: 1.4; border: 1px solid #e1e4e8; color: {{codeText}}\">{{content}}</pre>"
    },
    "quote": {
      "html": "<blockquote style=\"margin: 24px 0; padding: 14px 20px; background-color: #f8f9fa; border-left: 4px solid #808080; color: {{muted}}; font-size: 16px; line-height: 1.6; font-style: normal\">{{content}}</blockquote>"
    },
    "list": {
      "html": "<{{tag}}{{start}} style=\"margin: 24px 0; padding-left: 32px\">{{content}}</{{tag}}>"
    },
    "listItem": {
      "html": "<li style=\"margin: 12px 0; line-height: 1.8; color: {{muted}}\">{{content}}</li>"
    },
    "link": {
      "html": "<a href=\"{{href}}\" style=\"color: {{accent}}; text-decoration: none; border-bottom: 1px solid {{accent}}\">{{content}}</a>"
    },
    "tableHead": {
      "html": "<th style=\"background-color: {{surface}}; padding: 12px 16px; text-align: left; border: 1px solid #e1e4e8; font-weight: 600; color: {{muted}}\">{{content}}</th>"
    },
    "tableCell": {
      "html": "<td style=\"padding: 12px 16px; border: 1px solid #e1e4e8; color: {{muted}}\">{{content}}</td>"
    },
    "table": {
      "html": "<section style=\"overflow-x: auto; max-width: 100%;\"><table style=\"width: 100%; margin: 32px 0; border-collapse: collapse; font-size: 16px\">{{thead}}{{tbody}}</table></section>"
    },
    "image": {
      "html": "<img src=\"{{src}}\" alt=\"{{alt}}\" style=\"max-width: 100%; max-height: 600px; height: auto; display: block; margin: 32px auto; border-radius: 8px\" />"
    },
    "divider": {
      "html": "<hr style=\"margin: 48px 0; border: none; height: 1px; background-color: #e1e4e8\">"
    }
  }
}
