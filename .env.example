# 稿台本地开发用的环境变量示例。
# 复制成 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进版本库。
#
# 桌面客户端不需要这个文件：首次运行时会自动在用户数据目录生成一份，
# 登录口令与会话密钥都由程序随机生成。

# 模型服务商的 API Key
DEEPSEEK_API_KEY=

# OpenAI 兼容端点的前缀（会拼上 /chat/completions）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 应用登录口令。开发态也请改成随机值，别直接用这里的占位符——
# 这个口令是本机服务的钥匙，公开的默认值等于没设防：
#   node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
APP_PASSWORD=change-me

# 会话签名密钥与模型配置加密口令。开发态也请用随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-hex-string-before-real-use

# 公众号（可选）。也可以在「公众号」页面填写，会写进同一个 .env。
WECHAT_APPID=
WECHAT_APPSECRET=

# 公众号封面凭证。由「公众号」页面设置封面时自动写入，一般不用手填：
# WECHAT_THUMB_MEDIA_ID=
# WECHAT_THUMB_IMAGE=

# 把微信接口基址指向本地假服务器用（自测整条推送链路时才会设）。
# 默认是官方的 https://api.weixin.qq.com。
# GAOTAI_WECHAT_API_BASE=http://127.0.0.1:3099

# 授权服务器地址（生产必填，例：https://license.example.com）
GAOTAI_LICENSE_SERVER=
# 仅开发/测试：设为 1 跳过授权门禁。绝不能出现在打包产物里
GAOTAI_LICENSE_BYPASS=
