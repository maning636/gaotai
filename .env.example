# 稿台本地开发用的环境变量示例。
# 复制成 .env 后填入真实值；.env 已被 .gitignore 忽略，不会进版本库。
#
# 桌面客户端不需要这个文件：首次运行时会自动在用户数据目录生成一份，
# 登录口令与会话密钥都由程序随机生成。

# 模型服务商的 API Key
DEEPSEEK_API_KEY=

# OpenAI 兼容端点的前缀（会拼上 /chat/completions）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 应用登录口令。开发态也请改成随机值，别直接用这里的占位符——
# 这个口令是本机服务的钥匙，公开的默认值等于没设防：
#   node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
APP_PASSWORD=change-me

# 会话签名密钥与模型配置加密口令。开发态也请用随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-hex-string-before-real-use

# 公众号（可选）。也可以在「公众号」页面填写，会写进同一个 .env。
WECHAT_APPID=
WECHAT_APPSECRET=

# 公众号封面凭证。由「公众号」页面设置封面时自动写入，一般不用手填：
# WECHAT_THUMB_MEDIA_ID=
# WECHAT_THUMB_IMAGE=

# 把微信接口基址指向本地假服务器用（自测整条推送链路时才会设）。
# 默认是官方的 https://api.weixin.qq.com。
# GAOTAI_WECHAT_API_BASE=http://127.0.0.1:3099

# 授权服务器地址（生产必填，例：https://license.example.com）
GAOTAI_LICENSE_SERVER=
# 仅开发/测试：设为 1 跳过授权门禁。绝不能出现在打包产物里
GAOTAI_LICENSE_BYPASS=

# 授权服务器的微信公众号回调签名 Token（可选）。
# 在 license-server 的部署环境里设置：与微信公众号后台「开发配置 → 服务器配置」里的
# Token 保持一致，用于验证回调请求签名（sha1）。留空则 /wechat 一律 403。
# 只在部署环境配置，不写进代码或本文件真值。
WECHAT_TOKEN=
# 公众号原始 ID（gh_xxxx，可选），用作被动回复的 FromUserName；留空则填空串。
WECHAT_ORIGINAL_ID=

# 网页后台（/admin）的管理口令与会话签名密钥（可选，仅部署环境配置）。
# ADMIN_PASSWORD：登录后台的口令。留空则后台整体返回 503（未配置），
#   绝不降级成「无口令可进」——务必设置一个足够强的随机口令。
# ADMIN_SESSION_SECRET：会话令牌签名密钥。留空则用进程启动时随机生成的密钥，
#   服务重启后所有已登录会话失效（运维需重新登录）。
# 两者都属于凭据，不会写进任何日志。
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
